# 环境: demo / development / production
APP_ENV=demo

# 数据库类型: sqlite（演示/开发） 或 mysql（生产）
DB_TYPE=sqlite

# MySQL数据库配置（DB_TYPE=mysql时生效）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qingshaonian
DB_USER=
DB_PASSWORD=

# JWT配置（production 必须改成至少 32 位随机字符串）
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# 系统配置
APP_URL=http://localhost:8000
APP_NAME=青少年风险防范测评管理系统

# 初始管理员账号（production 不允许使用示例密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 初始平台管理员账号（production 不允许使用示例密码）
PLATFORM_ADMIN_USERNAME=padm
PLATFORM_ADMIN_PASSWORD=padm123

# 调试模式（production 必须为 false）
DEBUG=true
INIT_BUILTIN_QUESTIONNAIRES=true
INIT_DEMO_DATA=false

# 短信服务（可选；production 启用时必须配置）
SMS_ENABLED=false
SMS_API_URL=
SMS_APP_KEY=

# AI 服务（可选；production 启用时必须配置）
AI_ENABLED=false
AI_API_URL=
AI_API_KEY=
